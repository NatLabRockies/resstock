  Set fridge_schedule_act = (-0.487+0.019*Tin), !- Program Line 4
  ElseIf (Hour == 1),                     !- Program Line 5
  Set fridge_schedule_act = (-0.34+0.016*Tin), !- Program Line 6
  ElseIf (Hour == 2),                     !- Program Line 7
  Set fridge_schedule_act = (-0.37+0.017*Tin), !- Program Line 8
  ElseIf (Hour == 3),                     !- Program Line 9
  Set fridge_schedule_act = (-0.361+0.016*Tin), !- Program Line 10
  ElseIf (Hour == 4),                     !- Program Line 11
  Set fridge_schedule_act = (-0.515+0.018*Tin), !- Program Line 12
  ElseIf (Hour == 5),                     !- Program Line 13
  Set fridge_schedule_act = (-0.684+0.021*Tin), !- Program Line 14
  ElseIf (Hour == 6),                     !- Program Line 15
  Set fridge_schedule_act = (-0.471+0.019*Tin), !- Program Line 16
  ElseIf (Hour == 7),                     !- Program Line 17
  Set fridge_schedule_act = (-0.159+0.015*Tin), !- Program Line 18
  ElseIf (Hour == 8),                     !- Program Line 19
  Set fridge_schedule_act = (-0.079+0.015*Tin), !- Program Line 20
  ElseIf (Hour == 9),                     !- Program Line 21
  Set fridge_schedule_act = (-0.417+0.019*Tin), !- Program Line 22
  ElseIf (Hour == 10),                    !- Program Line 23
  Set fridge_schedule_act = (-0.411+0.018*Tin), !- Program Line 24
  ElseIf (Hour == 11),                    !- Program Line 25
  Set fridge_schedule_act = (-0.386+0.018*Tin), !- Program Line 26
  ElseIf (Hour == 12),                    !- Program Line 27
  Set fridge_schedule_act = (-0.24+0.016*Tin), !- Program Line 28
  ElseIf (Hour == 13),                    !- Program Line 29
  Set fridge_schedule_act = (-0.314+0.017*Tin), !- Program Line 30
  ElseIf (Hour == 14),                    !- Program Line 31
  Set fridge_schedule_act = (-0.16+0.015*Tin), !- Program Line 32
  ElseIf (Hour == 15),                    !- Program Line 33
  Set fridge_schedule_act = (-0.121+0.015*Tin), !- Program Line 34
  ElseIf (Hour == 16),                    !- Program Line 35
  Set fridge_schedule_act = (-0.469+0.02*Tin), !- Program Line 36
  ElseIf (Hour == 17),                    !- Program Line 37
  Set fridge_schedule_act = (-0.412+0.02*Tin), !- Program Line 38
  ElseIf (Hour == 18),                    !- Program Line 39
  Set fridge_schedule_act = (-0.091+0.017*Tin), !- Program Line 40
  ElseIf (Hour == 19),                    !- Program Line 41
  Set fridge_schedule_act = (0.077+0.014*Tin), !- Program Line 42
  ElseIf (Hour == 20),                    !- Program Line 43
  Set fridge_schedule_act = (-0.118+0.016*Tin), !- Program Line 44
  ElseIf (Hour == 21),                    !- Program Line 45
  Set fridge_schedule_act = (-0.247+0.017*Tin), !- Program Line 46
  ElseIf (Hour == 22),                    !- Program Line 47
  Set fridge_schedule_act = (-0.445+0.019*Tin), !- Program Line 48
  ElseIf (Hour == 23),                    !- Program Line 49
  Set fridge_schedule_act = (-0.544+0.02*Tin), !- Program Line 50
  EndIf;                                  !- Program Line 51

EnergyManagementSystem:Program,
  infil_program,                          !- Name
  Set p_m = 0.14,                         !- Program Line 1
  Set p_s = 0.22,                         !- Program Line 2
  Set s_m = 270,                          !- Program Line 3
  Set s_s = 370,                          !- Program Line 4
  Set z_m = 9.99744,                      !- Program Line 5
  Set z_s = 2.4384,                       !- Program Line 6
  Set f_t = (((s_m/z_m)^p_m)*((z_s/s_s)^p_s)), !- Program Line 7
  Set Tdiff = tin_s-tout_s,               !- Program Line 8
  Set dT = @Abs Tdiff,                    !- Program Line 9
  Set c = 0.0427,                         !- Program Line 10
  Set Cs = 0.0711,                        !- Program Line 11
  Set Cw = 0.1274,                        !- Program Line 12
  Set n = 0.65,                           !- Program Line 13
  Set sft = (f_t*0.7000000000000001),     !- Program Line 14
  Set temp1 = ((c*Cw)*((sft*site_vw_s)^(2*n)))^2, !- Program Line 15
  Set Qinf = (((c*Cs*(dT^n))^2)+temp1)^0.5, !- Program Line 16
  Set Qinf = (@Max Qinf 0),               !- Program Line 17
  Set mech_vent_house_fan_sensible_load_act = 0.0, !- Program Line 18
  Set mech_vent_house_fan_latent_load_act = 0.0, !- Program Line 19
  Set OASupInPb = out_pb_s,               !- Program Line 20
  Set OASupInTemp = tout_s,               !- Program Line 21
  Set OASupInW = out_wt_s,                !- Program Line 22
  Set OASupRho = (@RhoAirFnPbTdbW OASupInPb OASupInTemp OASupInW), !- Program Line 23
  Set OASupCp = (@CpAirFnW OASupInW),     !- Program Line 24
  Set OASupInEnth = (@HFnTdbW OASupInTemp OASupInW), !- Program Line 25
  Set ZoneTemp = tin_s,                   !- Program Line 26
  Set ZoneW = win_s,                      !- Program Line 27
  Set ZoneCp = (@CpAirFnW ZoneW),         !- Program Line 28
  Set ZoneAirEnth = (@HFnTdbW ZoneTemp ZoneW), !- Program Line 29
  Set mech_vent_house_fan_cfis_act = 0.0, !- Program Line 30
  Set QWHV_cfis_sup = 0.0,                !- Program Line 31
  Set QWHV_cfis_suppl_sup = 0.0,          !- Program Line 32
  Set QWHV_cfis_suppl_exh = 0.0,          !- Program Line 33
  Set Qrange = 0,                         !- Program Line 34
  Set Qrange = Qrange + 0.04719 * mech_vent_range_fan_0_sch_s, !- Program Line 35
  Set Qbath = 0,                          !- Program Line 36
  Set Qbath = Qbath + 0.04719 * mech_vent_bath_fan_0_sch_s, !- Program Line 37
  Set Qdryer = 0,                         !- Program Line 38
  Set Qdryer = Qdryer + 0.11312 * clothes_dryer_exhaust_0_sch_s, !- Program Line 39
  Set QWHV_sup = 0.0,                     !- Program Line 40
  Set QWHV_exh = 0.0,                     !- Program Line 41
  Set Qsupply = QWHV_sup + QWHV_cfis_sup + QWHV_cfis_suppl_sup, !- Program Line 42
  Set Qexhaust = Qrange + Qbath + Qdryer + QWHV_exh + QWHV_cfis_suppl_exh, !- Program Line 43
  Set Qfan = (@Max Qexhaust Qsupply),     !- Program Line 44
  Set Qducts = 0,                         !- Program Line 45
  Set Qducts = Qducts - air_source_heat_pump_airloop_0_DuctImbalLkSupFanEquivCond, !- Program Line 46
  Set Qducts = Qducts + air_source_heat_pump_airloop_0_DuctImbalLkExhFanEquivCond, !- Program Line 47
  If Qducts < 0,                          !- Program Line 48
  Set Qsupply = Qsupply - Qducts,         !- Program Line 49
  Else,                                   !- Program Line 50
  Set Qexhaust = Qexhaust + Qducts,       !- Program Line 51
  EndIf,                                  !- Program Line 52
  Set Qfan_with_ducts = (@Max Qexhaust Qsupply), !- Program Line 53
  Set Qimb = (@Abs (Qsupply - Qexhaust)), !- Program Line 54
  If Qinf + Qimb > 0,                     !- Program Line 55
  Set Qtot = Qfan_with_ducts + (Qinf^2) / (Qinf + Qimb), !- Program Line 56
  Else,                                   !- Program Line 57
  Set Qtot = Qfan_with_ducts,             !- Program Line 58
  EndIf,                                  !- Program Line 59
  Set Qinf_adj = Qtot - Qfan,             !- Program Line 60
  Set infil_flow_act = Qinf_adj,          !- Program Line 61
  Set infil_program_Qinf = Qinf_adj,      !- Program Line 62
  Set infil_program_Qfan = Qfan,          !- Program Line 63
  Set Qload = Qfan,                       !- Program Line 64
  Set Effectiveness_Sens = 0.0,           !- Program Line 65
  Set Effectiveness_Lat = 0.0,            !- Program Line 66
  Set Fan_MFR = Qload * OASupRho,         !- Program Line 67
  Set ZoneInEnth = OASupInEnth,           !- Program Line 68
  Set ZoneInTemp = OASupInTemp,           !- Program Line 69
  Set FanTotalToCond = Fan_MFR * (ZoneInEnth - ZoneAirEnth), !- Program Line 70
  Set FanSensToCond = Fan_MFR * ZoneCp * (ZoneInTemp - ZoneTemp), !- Program Line 71
  Set FanLatToCond = FanTotalToCond - FanSensToCond, !- Program Line 72
  Set mech_vent_house_fan_sensible_load_act = mech_vent_house_fan_sensible_load_act + FanSensToCond, !- Program Line 73
  Set mech_vent_house_fan_latent_load_act = mech_vent_house_fan_latent_load_act + FanLatToCond; !- Program Line 74

EnergyManagementSystem:Program,
  natural_vent_program,                   !- Name
  Set Tin = tin_s,                        !- Program Line 1
  Set Tout = tout_s,                      !- Program Line 2
  Set Wout = out_wt_s,                    !- Program Line 3
  Set Pbar = out_pb_s,                    !- Program Line 4
  Set Phiout = (@RhFnTdbWPb Tout Wout Pbar), !- Program Line 5
  Set MaxHR = 0.0115,                     !- Program Line 6
  Set Tnvsp = (htg_sp_s + clg_sp_s) / 2,  !- Program Line 7
  Set NVavail = natural_vent_s,           !- Program Line 8
  Set ClgSsnAvail = cool_season,          !- Program Line 9
  Set Qnv = 0,                            !- Program Line 10
  Set Qwhf = 0,                           !- Program Line 11
  Set whole_house_fan_mix_act = 0,        !- Program Line 12
  Set whole_house_fan_act = 0,            !- Program Line 13
  If ((Wout < MaxHR) && (Tin > Tout) && (Tin > Tnvsp) && (ClgSsnAvail > 0)), !- Program Line 14
  Set WHF_Flow = 0,                       !- Program Line 15
  Set Adj = (Tin-Tnvsp)/(Tin-Tout),       !- Program Line 16
  Set Adj = (@Min Adj 1),                 !- Program Line 17
  Set Adj = (@Max Adj 0),                 !- Program Line 18
  If (WHF_Flow > 0),                      !- Program Line 19
  Set Qwhf = WHF_Flow*Adj,                !- Program Line 20
  Set whole_house_fan_mix_act = WHF_Flow*Adj, !- Program Line 21
  Set WHF_W = 0,                          !- Program Line 22
  Set whole_house_fan_act = WHF_W*Adj,    !- Program Line 23
  ElseIf (NVavail > 0),                   !- Program Line 24
  Set NVArea = 17463.467524608,           !- Program Line 25
  Set Cs = 8.968567957270247e-05,         !- Program Line 26
  Set Cw = 6.531778328561744e-05,         !- Program Line 27
  Set Tdiff = Tin-Tout,                   !- Program Line 28
  Set dT = (@Abs Tdiff),                  !- Program Line 29
  Set Vwind = site_vw_s,                  !- Program Line 30
  Set SGNV = NVArea*Adj*((((Cs*dT)+(Cw*(Vwind^2)))^0.5)/1000), !- Program Line 31
  Set MaxNV = 2.7423292766208007,         !- Program Line 32
  Set Qnv = (@Min SGNV MaxNV),            !- Program Line 33
  EndIf,                                  !- Program Line 34
  EndIf,                                  !- Program Line 35
  Set natural_vent_flow_act = Qnv,        !- Program Line 36
  Set whole_house_fan_flow_act = Qwhf,    !- Program Line 37
  Set natural_vent_program_Qnv = Qnv,     !- Program Line 38
  Set natural_vent_program_Qwhf = Qwhf;   !- Program Line 39

EnergyManagementSystem:Program,
  total_airflows_program,                 !- Name
  Set total_infil_flow_rate = 0,          !- Program Line 1
  Set total_mechvent_flow_rate = 0,       !- Program Line 2
  Set total_natvent_flow_rate = 0,        !- Program Line 3
  Set total_whf_flow_rate = 0,            !- Program Line 4
  Set total_infil_flow_rate = total_infil_flow_rate + (infil_program_Qinf * 1), !- Program Line 5
  Set total_mechvent_flow_rate = total_mechvent_flow_rate + (infil_program_Qfan * 1), !- Program Line 6
  Set total_natvent_flow_rate = total_natvent_flow_rate + (natural_vent_program_Qnv * 1), !- Program Line 7
  Set total_whf_flow_rate = total_whf_flow_rate + (natural_vent_program_Qwhf * 1); !- Program Line 8

EnergyManagementSystem:Program,
  total_loads_program,                    !- Name
  Set loads_htg_tot = 0,                  !- Program Line 1
  Set loads_clg_tot = 0,                  !- Program Line 2
  If htg_load_cond > 0,                   !- Program Line 3
  Set loads_htg_tot = loads_htg_tot + (htg_load_cond - clg_load_cond) * 1.0, !- Program Line 4
  Set loads_htg_tot = loads_htg_tot + (htg_load_duct - clg_load_duct) * 1.0, !- Program Line 5
  Set loads_htg_tot = loads_htg_tot + ig_defrost_0 * 1, !- Program Line 6
  EndIf,                                  !- Program Line 7
  Set loads_htg_tot = (@Max loads_htg_tot 0), !- Program Line 8
  If clg_load_cond > 0,                   !- Program Line 9
  Set loads_clg_tot = loads_clg_tot + (clg_load_cond - htg_load_cond) * 1.0, !- Program Line 10
  Set loads_clg_tot = loads_clg_tot + (clg_load_duct - htg_load_duct) * 1.0, !- Program Line 11
  EndIf,                                  !- Program Line 12
  Set loads_clg_tot = (@Max loads_clg_tot 0); !- Program Line 13

EnergyManagementSystem:Program,
  unmet_hours_program,                    !- Name
  Set htg_unmet_hours = 0,                !- Program Line 1
  Set clg_unmet_hours = 0,                !- Program Line 2
  Set unit_htg_unmet_hours = 0,           !- Program Line 3
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 4
  Set unit_htg_unmet_hours = unit_htg_unmet_hours + conditioned_space_htg_unmet_s, !- Program Line 5
  If unit_htg_unmet_hours > htg_unmet_hours, !- Program Line 6
  Set htg_unmet_hours = unit_htg_unmet_hours, !- Program Line 7
  EndIf,                                  !- Program Line 8
  EndIf,                                  !- Program Line 9
  Set unit_clg_unmet_hours = 0,           !- Program Line 10
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 11
  Set unit_clg_unmet_hours = unit_clg_unmet_hours + conditioned_space_clg_unmet_s, !- Program Line 12
  If unit_clg_unmet_hours > clg_unmet_hours, !- Program Line 13
  Set clg_unmet_hours = unit_clg_unmet_hours, !- Program Line 14
  EndIf,                                  !- Program Line 15
  EndIf;                                  !- Program Line 16

EnergyManagementSystem:Program,
  water_heater_EC_adj,                    !- Name
  If WarmupFlag == 0,                     !- Program Line 1
  Set dhw_e_cons = water_heater_energy + water_heater_on_cycle_parasitic + water_heater_off_cycle_parasitic, !- Program Line 2
  Set water_heater_ec_adj_act = 0.0 * dhw_e_cons / 1, !- Program Line 3
  EndIf;                                  !- Program Line 4

EnergyManagementSystem:Subroutine,
  air_source_heat_pump_airloop_0_duct_subroutine, !- Name
  Set AH_MFR = air_source_heat_pump_airloop_AH_MFR / 1, !- Program Line 1
  If AH_MFR > 0,                          !- Program Line 2
  Set AH_Tout = air_source_heat_pump_airloop_AH_Tout, !- Program Line 3
  Set AH_Wout = air_source_heat_pump_airloop_AH_Wout, !- Program Line 4
  Set RA_T = air_source_heat_pump_airloop_RA_T, !- Program Line 5
  Set RA_W = air_source_heat_pump_airloop_Ra_W, !- Program Line 6
  Set Fan_RTF = air_source_heat_pump_airloop_Fan_RTF, !- Program Line 7
  Set DZ_T = air_source_heat_pump_airloop_0_DZ_T, !- Program Line 8
  Set DZ_W = air_source_heat_pump_airloop_0_DZ_W, !- Program Line 9
  Set AH_VFR = air_source_heat_pump_airloop_AH_VFR / 1, !- Program Line 10
  Set h_SA = (@HFnTdbW AH_Tout AH_Wout),  !- Program Line 11
  Set h_RA = (@HFnTdbW RA_T RA_W),        !- Program Line 12
  Set h_fg = (@HfgAirFnWTdb AH_Wout AH_Tout), !- Program Line 13
  Set h_DZ = (@HFnTdbW DZ_T DZ_W),        !- Program Line 14
  Set air_cp = 1006.0,                    !- Program Line 15
  Set f_sup = 0.05,                       !- Program Line 16
  Set f_ret = 0.05,                       !- Program Line 17
  Set sup_lk_mfr = f_sup * AH_MFR,        !- Program Line 18
  Set ret_lk_mfr = f_ret * AH_MFR,        !- Program Line 19
  Set SupTotLkToCond = sup_lk_mfr*(h_RA - h_SA), !- Program Line 20
  Set SupLatLkToCond = sup_lk_mfr*h_fg*(RA_W-AH_Wout), !- Program Line 21
  Set SupSensLkToCond = SupTotLkToCond-SupLatLkToCond, !- Program Line 22
  Set supply_ua = 54.161,                 !- Program Line 23
  Set eTm = 0-((Fan_RTF/(AH_MFR*air_cp))*supply_ua), !- Program Line 24
  Set t_sup = DZ_T+((AH_Tout-DZ_T)*(@Exp eTm)), !- Program Line 25
  Set SupCondToCond = AH_MFR*air_cp*(t_sup-AH_Tout), !- Program Line 26
  Set SupCondToDZ = 0-SupCondToCond,      !- Program Line 27
  Set return_ua = 8.21,                   !- Program Line 28
  Set eTm = 0-((Fan_RTF/(AH_MFR*air_cp))*return_ua), !- Program Line 29
  Set t_ret = DZ_T+((RA_T-DZ_T)*(@Exp eTm)), !- Program Line 30
  Set RetCondToRP = AH_MFR*air_cp*(t_ret-RA_T), !- Program Line 31
  Set RetCondToDZ = 0-RetCondToRP,        !- Program Line 32
  Set RetLatLkToRP = 0,                   !- Program Line 33
  Set RetSensLkToRP = ret_lk_mfr*air_cp*(DZ_T-RA_T), !- Program Line 34
  Set SupTotLkToDZ = sup_lk_mfr*(h_SA-h_DZ), !- Program Line 35
  Set SupLatLkToDZ = sup_lk_mfr*h_fg*(AH_Wout-DZ_W), !- Program Line 36
  Set SupSensLkToDZ = SupTotLkToDZ-SupLatLkToDZ, !- Program Line 37
  Set FracOutsideToCond = 0.0,            !- Program Line 38
  Set FracOutsideToDZ = 0.0,              !- Program Line 39
  Set FracCondToOutside = 0.0,            !- Program Line 40
  Set FracDZToOutside = 0.0,              !- Program Line 41
  Set FracDZToCond = 0.0,                 !- Program Line 42
  Set FracCondToDZ = 0.0,                 !- Program Line 43
  Set lk_imbal_vfr = @ABS(f_sup - f_ret) * AH_VFR, !- Program Line 44
  Set ImbalLkCondToDZ = lk_imbal_vfr * FracCondToDZ, !- Program Line 45
  Set ImbalLkDZToCond = lk_imbal_vfr * FracDZToCond, !- Program Line 46
  Set ImbalLkOutsideToCond = lk_imbal_vfr * FracOutsideToCond, !- Program Line 47
  Set ImbalLkOutsideToDZ = lk_imbal_vfr * FracOutsideToDZ, !- Program Line 48
  Set ImbalLkCondToOutside = lk_imbal_vfr * FracCondToOutside, !- Program Line 49
  Set ImbalLkDZToOutside = lk_imbal_vfr * FracDZToOutside, !- Program Line 50
  Else,                                   !- Program Line 51
  Set SupLatLkToCond = 0,                 !- Program Line 52
  Set SupSensLkToCond = 0,                !- Program Line 53
  Set SupCondToCond = 0,                  !- Program Line 54
  Set RetCondToRP = 0,                    !- Program Line 55
  Set RetLatLkToRP = 0,                   !- Program Line 56
  Set RetSensLkToRP = 0,                  !- Program Line 57
  Set RetCondToDZ = 0,                    !- Program Line 58
  Set SupCondToDZ = 0,                    !- Program Line 59
  Set SupLatLkToDZ = 0,                   !- Program Line 60
  Set SupSensLkToDZ = 0,                  !- Program Line 61
  Set ImbalLkCondToDZ = 0,                !- Program Line 62
  Set ImbalLkDZToCond = 0,                !- Program Line 63
  Set ImbalLkOutsideToCond = 0,           !- Program Line 64
  Set ImbalLkOutsideToDZ = 0,             !- Program Line 65
  Set ImbalLkCondToOutside = 0,           !- Program Line 66
  Set ImbalLkDZToOutside = 0,             !- Program Line 67
  EndIf,                                  !- Program Line 68
  Set air_source_heat_pump_airloop_0_SupLatLkToCond = SupLatLkToCond, !- Program Line 69
  Set air_source_heat_pump_airloop_0_SupSensLkToCond = SupSensLkToCond, !- Program Line 70
  Set air_source_heat_pump_airloop_0_SupCondToLv = SupCondToCond, !- Program Line 71
  Set air_source_heat_pump_airloop_0_RetCondToRP = RetCondToRP, !- Program Line 72
  Set air_source_heat_pump_airloop_0_RetLatLkToRP = RetLatLkToRP, !- Program Line 73
  Set air_source_heat_pump_airloop_0_RetSensLkToRP = RetSensLkToRP, !- Program Line 74
  Set air_source_heat_pump_airloop_0_RetCondToDZ = RetCondToDZ, !- Program Line 75
  Set air_source_heat_pump_airloop_0_SupCondToDZ = SupCondToDZ, !- Program Line 76
  Set air_source_heat_pump_airloop_0_SupLatLkToDZ = SupLatLkToDZ, !- Program Line 77
  Set air_source_heat_pump_airloop_0_SupSensLkToDZ = SupSensLkToDZ, !- Program Line 78
  Set air_source_heat_pump_airloop_0_ZoneMixCondToDZ = ImbalLkCondToDZ, !- Program Line 79
  Set air_source_heat_pump_airloop_0_ZoneMixDZToCond = ImbalLkDZToCond, !- Program Line 80
  Set air_source_heat_pump_airloop_0_DuctImbalLkSupFanEquivCond = ImbalLkCondToOutside, !- Program Line 81
  Set air_source_heat_pump_airloop_0_DuctImbalLkExhFanEquivCond = ImbalLkOutsideToCond, !- Program Line 82
  Set air_source_heat_pump_airloop_0_DuctImbalLkSupFanEquivDZ = ImbalLkDZToOutside, !- Program Line 83
  Set air_source_heat_pump_airloop_0_DuctImbalLkExhFanEquivDZ = ImbalLkOutsideToDZ; !- Program Line 84

