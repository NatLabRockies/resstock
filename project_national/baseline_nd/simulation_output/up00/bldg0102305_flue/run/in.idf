  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 111
  Set htg_season = 1,                     !- Program Line 112
  EndIf,                                  !- Program Line 113
  If ((airflow_gain_1 <> 0) || (airflow_loss_1 <> 0)) && (clg_season == 1), !- Program Line 114
  Set clg_mode = 1.0,                     !- Program Line 115
  ElseIf ((airflow_gain_2 <> 0) || (airflow_loss_2 <> 0)) && (clg_season == 1), !- Program Line 116
  Set clg_mode = 1.0,                     !- Program Line 117
  Else,                                   !- Program Line 118
  Set Tmid_setpoint = (htg_sp_s_1 + clg_sp_s_1) / 2, !- Program Line 119
  If (tin_s_1 > Tmid_setpoint) && (clg_season == 1), !- Program Line 120
  Set clg_mode = 1.0,                     !- Program Line 121
  ElseIf (tin_s_1 < Tmid_setpoint) && (htg_season == 1), !- Program Line 122
  Set htg_mode = 1.0,                     !- Program Line 123
  EndIf,                                  !- Program Line 124
  EndIf,                                  !- Program Line 125
  EndIf,                                  !- Program Line 126
  Set loads_htg_walls = loads_htg_walls + (hr_walls * htg_mode * 1), !- Program Line 127
  Set loads_htg_rim_joists = loads_htg_rim_joists + (hr_rim_joists * htg_mode * 1), !- Program Line 128
  Set loads_htg_foundation_walls = loads_htg_foundation_walls + (hr_foundation_walls * htg_mode * 1), !- Program Line 129
  Set loads_htg_floors = loads_htg_floors + (hr_floors * htg_mode * 1), !- Program Line 130
  Set loads_htg_slabs = loads_htg_slabs + (hr_slabs * htg_mode * 1), !- Program Line 131
  Set loads_htg_ceilings = loads_htg_ceilings + (hr_ceilings * htg_mode * 1), !- Program Line 132
  Set loads_htg_roofs = loads_htg_roofs + (hr_roofs * htg_mode * 1), !- Program Line 133
  Set loads_htg_windows_conduction = loads_htg_windows_conduction + (hr_windows_conduction * htg_mode * 1), !- Program Line 134
  Set loads_htg_windows_solar = loads_htg_windows_solar + (hr_windows_solar * htg_mode * 1), !- Program Line 135
  Set loads_htg_doors = loads_htg_doors + (hr_doors * htg_mode * 1), !- Program Line 136
  Set loads_htg_skylights_conduction = loads_htg_skylights_conduction + (hr_skylights_conduction * htg_mode * 1), !- Program Line 137
  Set loads_htg_skylights_solar = loads_htg_skylights_solar + (hr_skylights_solar * htg_mode * 1), !- Program Line 138
  Set loads_htg_internal_mass = loads_htg_internal_mass + (hr_internal_mass * htg_mode * 1), !- Program Line 139
  Set loads_htg_intgains = loads_htg_intgains + (hr_intgains * htg_mode * 1), !- Program Line 140
  Set loads_htg_lighting = loads_htg_lighting + (hr_lighting * htg_mode * 1), !- Program Line 141
  Set loads_htg_infil = loads_htg_infil + (hr_infil * htg_mode * 1), !- Program Line 142
  Set loads_htg_mechvent = loads_htg_mechvent + (hr_mechvent * htg_mode * 1), !- Program Line 143
  Set loads_htg_natvent = loads_htg_natvent + (hr_natvent * htg_mode * 1), !- Program Line 144
  Set loads_htg_whf = loads_htg_whf + (hr_whf * htg_mode * 1), !- Program Line 145
  Set loads_htg_ducts = loads_htg_ducts + (hr_ducts * htg_mode * 1), !- Program Line 146
  Set loads_clg_walls = loads_clg_walls + (-hr_walls * clg_mode * 1), !- Program Line 147
  Set loads_clg_rim_joists = loads_clg_rim_joists + (-hr_rim_joists * clg_mode * 1), !- Program Line 148
  Set loads_clg_foundation_walls = loads_clg_foundation_walls + (-hr_foundation_walls * clg_mode * 1), !- Program Line 149
  Set loads_clg_floors = loads_clg_floors + (-hr_floors * clg_mode * 1), !- Program Line 150
  Set loads_clg_slabs = loads_clg_slabs + (-hr_slabs * clg_mode * 1), !- Program Line 151
  Set loads_clg_ceilings = loads_clg_ceilings + (-hr_ceilings * clg_mode * 1), !- Program Line 152
  Set loads_clg_roofs = loads_clg_roofs + (-hr_roofs * clg_mode * 1), !- Program Line 153
  Set loads_clg_windows_conduction = loads_clg_windows_conduction + (-hr_windows_conduction * clg_mode * 1), !- Program Line 154
  Set loads_clg_windows_solar = loads_clg_windows_solar + (-hr_windows_solar * clg_mode * 1), !- Program Line 155
  Set loads_clg_doors = loads_clg_doors + (-hr_doors * clg_mode * 1), !- Program Line 156
  Set loads_clg_skylights_conduction = loads_clg_skylights_conduction + (-hr_skylights_conduction * clg_mode * 1), !- Program Line 157
  Set loads_clg_skylights_solar = loads_clg_skylights_solar + (-hr_skylights_solar * clg_mode * 1), !- Program Line 158
  Set loads_clg_internal_mass = loads_clg_internal_mass + (-hr_internal_mass * clg_mode * 1), !- Program Line 159
  Set loads_clg_intgains = loads_clg_intgains + (-hr_intgains * clg_mode * 1), !- Program Line 160
  Set loads_clg_lighting = loads_clg_lighting + (-hr_lighting * clg_mode * 1), !- Program Line 161
  Set loads_clg_infil = loads_clg_infil + (-hr_infil * clg_mode * 1), !- Program Line 162
  Set loads_clg_mechvent = loads_clg_mechvent + (-hr_mechvent * clg_mode * 1), !- Program Line 163
  Set loads_clg_natvent = loads_clg_natvent + (-hr_natvent * clg_mode * 1), !- Program Line 164
  Set loads_clg_whf = loads_clg_whf + (-hr_whf * clg_mode * 1), !- Program Line 165
  Set loads_clg_ducts = loads_clg_ducts + (-hr_ducts * clg_mode * 1); !- Program Line 166

EnergyManagementSystem:Program,
  crawlspace_vented_1_duct_leakage_imbalance_infil_program, !- Name
