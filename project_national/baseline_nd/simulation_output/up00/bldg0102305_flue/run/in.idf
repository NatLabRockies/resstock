EnergyManagementSystem:Program,
  air_source_heat_pump_htg_coil_defrost_program, !- Name
  Set T_out = air_source_heat_pump_htg_coil_tout_s, !- Program Line 1
  Set F_defrost = 0.134 - (0.003 * ((T_out * 1.8) + 32)), !- Program Line 2
  Set F_defrost = @Min F_defrost 0.08,    !- Program Line 3
  Set F_defrost = @Max F_defrost 0,       !- Program Line 4
  Set air_source_heat_pump_htg_coil_frost_cap_multiplier_act = 1.0 - (1.8 * F_defrost), !- Program Line 5
  Set air_source_heat_pump_htg_coil_frost_pow_multiplier_act = 1.0 - (0.3 * F_defrost), !- Program Line 6
  If T_out <= 4.44444444444444,           !- Program Line 7
  Set F_compressor = 1.0 - F_defrost,     !- Program Line 8
  Set fraction_defrost = F_defrost * air_source_heat_pump_htg_coil_rtf_s, !- Program Line 9
  If air_source_heat_pump_htg_coil_rtf_s > 0, !- Program Line 10
  Set q_dot_defrost = ((F_compressor * (air_source_heat_pump_htg_coil_deliverd_htg / air_source_heat_pump_htg_coil_frost_cap_multiplier_act) - air_source_heat_pump_htg_coil_deliverd_htg) / fraction_defrost) / 1, !- Program Line 11
  Set reduced_cap = (((air_source_heat_pump_htg_coil_deliverd_htg / air_source_heat_pump_htg_coil_frost_cap_multiplier_act) - air_source_heat_pump_htg_coil_deliverd_htg) / fraction_defrost) / 1, !- Program Line 12
  Else,                                   !- Program Line 13
  Set q_dot_defrost = 0.0,                !- Program Line 14
  Set reduced_cap = 0.0,                  !- Program Line 15
  EndIf,                                  !- Program Line 16
  Set supp_capacity = 17917.779088189323, !- Program Line 17
  Set supp_efficiency = 1.0,              !- Program Line 18
  Set supp_delivered_htg = @Min reduced_cap supp_capacity, !- Program Line 19
  If supp_efficiency > 0.0,               !- Program Line 20
  Set supp_design_level = (supp_delivered_htg / supp_efficiency), !- Program Line 21
  Else,                                   !- Program Line 22
  Set supp_design_level = 0.0,            !- Program Line 23
  EndIf,                                  !- Program Line 24
  Set air_source_heat_pump_htg_coil_defrost_heat_load_act = (supp_delivered_htg - q_dot_defrost) * fraction_defrost, !- Program Line 25
  Set air_source_heat_pump_htg_coil_defrost_supp_heat_energy_act = fraction_defrost * supp_design_level, !- Program Line 26
  Else,                                   !- Program Line 27
  Set air_source_heat_pump_htg_coil_defrost_heat_load_act = 0, !- Program Line 28
  Set air_source_heat_pump_htg_coil_defrost_supp_heat_energy_act = 0, !- Program Line 29
  EndIf,                                  !- Program Line 30
  If (T_out <= 0.0),                      !- Program Line 31
  Set air_source_heat_pump_htg_coil_pan_heater_energy_act = 150.0, !- Program Line 32
  Else,                                   !- Program Line 33
  Set air_source_heat_pump_htg_coil_pan_heater_energy_act = 0.0, !- Program Line 34
  EndIf;                                  !- Program Line 35

EnergyManagementSystem:Program,
